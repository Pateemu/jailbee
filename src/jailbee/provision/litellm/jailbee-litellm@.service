[Unit]
Description=JailBee LiteLLM proxy (%i)
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/var/lib/jailbee-litellm/%i/instance.env
Environment=PYTHONPATH=/var/lib/jailbee-litellm/callback
ExecStart=/opt/litellm/bin/litellm --config /var/lib/jailbee-litellm/%i/config.yaml --host 0.0.0.0 --port ${PORT}
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
